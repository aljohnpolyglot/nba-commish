# Logo.dev publishable token — safe client-side
# Get one at https://www.logo.dev (free tier)
VITE_LOGODEV_TOKEN=

# Optional external sponsor catalog; bundled league pools are used when omitted.
VITE_SPONSOR_CATALOG_URL=

# Optional production data proxy for large third-party JSON files.
# Local Vite dev uses /__data_proxy automatically.
VITE_DATA_PROXY_URL=

# Optional real-world basketball data gateway; bundled validated snapshots remain the fallback.
VITE_BASKETBALL_DATA_WORKER_URL=

# Optional chat Worker URL when using a custom Worker hostname.
VITE_CHAT_WORKER_URL=
